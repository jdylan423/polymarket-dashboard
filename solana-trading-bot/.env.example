# WALLET & RPC
WALLET_PRIVATE_KEY=your_wallet_private_key_here
WALLET_ADDRESS=7TCVKKobfYgubXJaQVNnAKjK6QRWVcuZWFxYYDQ2jUrF
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET=wss://api.mainnet-beta.solana.com

# RISK MANAGEMENT
STARTING_CAPITAL_SOL=2
MAX_POSITION_SIZE_SOL=0.5
MAX_SIMULTANEOUS_POSITIONS=4
STOP_LOSS_PERCENT=-20
TAKE_PROFIT_PERCENT=30
PORTFOLIO_STOP_LOSS_PERCENT=-30

# STRATEGY PARAMETERS
MIN_LIQUIDITY_USD=1000000
TOKEN_MIN_AGE_HOURS=24
SCAN_INTERVAL_SECONDS=30
BUY_VOLUME_WINDOW_HOURS=4
RESISTANCE_BREAKOUT_THRESHOLD=2.5

# SOCIAL SENTIMENT REQUIREMENTS
SENTIMENT_PLATFORMS=twitter,discord,telegram
MINIMUM_SENTIMENT_SCORE=0.6
MINIMUM_VOLUME_TRENDING_SCORE=0.7

# API KEYS
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
DISCORD_WEBHOOK_ALERTS=your_discord_webhook_url

# EXECUTION
DRY_RUN=false
SLIPPAGE_TOLERANCE=1.5
PRIORITY_FEE_LAMPORTS=100000

# LOGGING
LOG_LEVEL=info
LOG_FILE=logs/trading.log
LOG_RETENTION_DAYS=30

# DASHBOARD
DASHBOARD_PORT=3001

# ADVANCED
DEBUG_MODE=false
ENABLE_SAFEGUARDS=true
MAX_DAILY_LOSS_SOL=0.6
